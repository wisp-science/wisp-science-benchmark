HF_TOKEN=

WISP_BIN=/ABS/PATH/wisp-science/target/release/wisp-science
WISP_ROOT=/ABS/PATH/wisp-science
OMICOS_BIOMNIBENCH_ROOT=/ABS/PATH/omicos-biomnibench
OMICOS_BIOMNIBENCH_DATA_DIR=/ABS/PATH/BiomniBench-AI4S/data

# judge: keep DeepSeek for all comparable runs
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# scientific Python bin/ prepended to PATH
OSCI_KERNEL_BIN=/ABS/PATH/benchmark/envs/omicdev/bin

# agent model (one model per run; leave the identity WISP_* unset to fall back to DEEPSEEK_*)
WISP_PROVIDER=anthropic
WISP_API_URL=https://api.kimi.com/coding/
WISP_MODEL=kimi-k3
WISP_API_KEY=
WISP_VISION=1
