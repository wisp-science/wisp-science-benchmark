HF_TOKEN=

# Wisp headless binary + source tree (mounted into the task container)
WISP_BIN=/ABS/PATH/wisp-science/target/release/wisp-science
WISP_ROOT=/ABS/PATH/wisp-science

# NatureBench clone (not in this git repo)
NATUREBENCH_ROOT=/ABS/PATH/benchmark/NatureBench

# Agent model: one model per run. --model must match WISP_MODEL.
WISP_PROVIDER=anthropic
WISP_API_URL=https://api.kimi.com/coding/
WISP_MODEL=kimi-k3
WISP_API_KEY=
WISP_VISION=1
# WISP_REASONING_EFFORT=none
# WISP_MAX_TOKENS=32768
# WISP_MAX_ITER=200

# Post-hoc validity judge (official reported runs use GPT-5.5)
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=gpt-5.5
