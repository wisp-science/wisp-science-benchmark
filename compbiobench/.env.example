HF_TOKEN=

# Wisp headless binary + source tree (kernel_worker.py + skills/)
WISP_BIN=/ABS/PATH/wisp-science/target/release/wisp-science
WISP_ROOT=/ABS/PATH/wisp-science

# Hugging Face dump of Genentech/compbiobench-data-v1
COMPBIO_DATA_DIR=/ABS/PATH/benchmark/compbiobench-data

# Agent model: one model per run. -m must match WISP_MODEL.
WISP_PROVIDER=anthropic
WISP_API_URL=https://api.kimi.com/coding/
WISP_MODEL=kimi-k3
WISP_API_KEY=
WISP_VISION=1
# WISP_REASONING_EFFORT=none
# WISP_MAX_TOKENS=32768
# WISP_MAX_ITER=200
