HF_TOKEN=

# Wisp headless binary + source tree (kernel_worker.py + skills/)
WISP_BIN=/ABS/PATH/wisp-science/target/release/wisp-science
WISP_ROOT=/ABS/PATH/wisp-science

# Hugging Face dump of Genentech/compbiobench-data-v1
COMPBIO_DATA_DIR=/ABS/PATH/benchmark/compbiobench-data
# Shared warmup cache (conda extras, genomes, containers, models)
COMPBIO_CACHE_DIR=/ABS/PATH/benchmark/compbiobench-cache
# Optional Hugging Face mirror used by warmup and the agent
# HF_ENDPOINT=https://hf-mirror.com
# Optional Docker Hub mirrors, comma-separated, tried after docker.io
# COMPBIO_DOCKER_MIRRORS=docker.m.daocloud.io
# Force conda/mamba/micromamba binary (default: conda install if present, else micromamba)
# COMPBIO_CONDA_CMD=micromamba

# Agent model: one model per run. -m must match WISP_MODEL.
WISP_PROVIDER=anthropic
WISP_API_URL=https://api.kimi.com/coding/
WISP_MODEL=kimi-k3
WISP_API_KEY=
WISP_VISION=1
# WISP_REASONING_EFFORT=none
# WISP_MAX_TOKENS=32768
# WISP_MAX_ITER=200
